# Per-property environment for deploy/docker-compose.yaml + the image's
# deploy/settings.prod.php. Copy to `.env` next to the compose file ON THE
# HOST and fill in — never commit a filled-in copy (root .gitignore ignores
# `.env`). Generate secrets with:  openssl rand -hex 32
#
# Every key is read by exactly one of: compose interpolation (stack shape),
# the mariadb image (DB bootstrap), or settings.prod.php (Drupal runtime).
# Comments on their own lines only — this file is parsed by two dotenv
# readers (compose interpolation + env_file) and inline comments are not
# portable across their versions.

# --- Stack shape (compose interpolation) --------------------------------
# container/network prefix + Traefik router name
COMPOSE_PROJECT_NAME=mythingname
# what CI pushed
IMAGE=ghcr.io/<owner>/mythingname:latest
# public host; www. is routed too
APEX=example.com
# reverse proxy's shared docker network (docker network create <name>)
EDGE_NETWORK=edge
# certresolver name in the proxy's config
TRAEFIK_CERTRESOLVER=letsencrypt

# --- MariaDB bootstrap (mariadb image, first start only) ----------------
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=drupal
MARIADB_USER=drupal
MARIADB_PASSWORD=

# --- Drupal runtime (settings.prod.php) ---------------------------------
DRUPAL_DB_HOST=db
DRUPAL_DB_PORT=3306
# the three below mirror MARIADB_DATABASE / MARIADB_USER / MARIADB_PASSWORD
DRUPAL_DB_NAME=drupal
DRUPAL_DB_USER=drupal
DRUPAL_DB_PASSWORD=
# openssl rand -hex 32 — NEVER rotate on a live site (invalidates sessions,
# one-time links, and some hashed data)
DRUPAL_HASH_SALT=
# comma-separated regexes
DRUPAL_TRUSTED_HOSTS=^example\.com$,^www\.example\.com$
# default matches the compose volume; uncomment to override
# DRUPAL_PRIVATE_PATH=/opt/drupal/private

# --- Outbound mail (settings.prod.php) ----------------------------------
# The base image has NO local MTA, so without MAILER_DSN every mail Drupal
# sends fails — and a contact form still tells the visitor "message sent".
# One Symfony Mailer DSN carries the whole credential, so no secret ever
# reaches config/sync. Any relay works; examples:
#   smtp://user:pass@smtp.example.com:587
#   smtp://apikey:SG.xxxxxxxx@smtp.sendgrid.net:587
#   smtp://postmaster%40mg.example.com:pass@smtp.mailgun.org:587
# URL-encode reserved characters in the password (@ -> %40, / -> %2F).
MAILER_DSN=
# From: address on everything Drupal sends. Must be on a domain the relay is
# authorised for (SPF/DKIM), or mail is spam-filed.
SITE_MAIL=noreply@example.com
# Where the site-wide contact form delivers. Comma-separated for several.
# A dev environment must point this somewhere harmless, never the real inbox.
CONTACT_RECIPIENT=

# --- Project settings (env-driven; see settings.prod.php footer) ---------
# DRUPAL_GA4_ID=G-XXXXXXXXXX
