# What must NOT reach the production image build context.
# The Dockerfile does `COPY . /opt/drupal/` — this file is the only thing
# standing between your workstation state and the image. Keep it honest.

# --- Composer-managed: regenerated by `composer install` in the image ---
vendor/
web/core/
web/modules/contrib/
web/themes/contrib/
web/profiles/contrib/
web/libraries/

# --- Per-site runtime state: volumes in production, never in the image ---
web/sites/*/files/
web/sites/*/private/
web/sites/*/settings.local.php
web/sites/*/settings.ddev.php
web/sites/*/services.local.yml
web/sites/default/settings.php

# --- Local dev tooling ---
.ddev/
.git/
.github/
.gitignore
.gitattributes
.editorconfig
Dockerfile
.dockerignore
optional/
**/node_modules/
phpunit.xml.dist
phpstan.neon
phpcs.xml.dist
.phpunit.cache/
.phpunit.result.cache
coverage/

# --- Docs (the image serves a site, not a repo) ---
docs/
*.md
LICENSE*

# --- Secrets: belt-and-suspenders (deploy/.env.example is keys-only and
#     lives one level down, so it is not caught by these root patterns) ---
.env
.env.*
**/*.pem
**/*.key

# --- OS / editor noise ---
**/.DS_Store
**/Thumbs.db
.idea/
.vscode/
**/*.swp
