# What must NOT reach the production image build context.
# The Dockerfile does `COPY . /opt/drupal/` — this file is the only thing
# standing between your workstation state and the image. Keep it honest.

# --- Composer-managed: regenerated by `composer install` in the image ---
vendor/
web/core/
web/modules/contrib/
web/themes/contrib/
web/profiles/contrib/
web/libraries/

# --- Per-site runtime state: volumes in production, never in the image ---
web/sites/*/files/
web/sites/*/private/
private/
# A private path mistyped as a stream wrapper ("private:/…") makes a directory
# named web/private: beside the docroot, full of private files.
web/private*
web/sites/*/settings.local.php
web/sites/*/settings.ddev.php
web/sites/*/services.local.yml
web/sites/default/settings.php

# --- Local dev tooling ---
.ddev/
.git/
.github/
.gitignore
.gitattributes
.editorconfig
Dockerfile
.dockerignore
optional/
**/node_modules/
phpunit.xml.dist
phpstan.neon
phpcs.xml.dist
.phpunit.cache/
.phpunit.result.cache
coverage/

# --- Docs (the image serves a site, not a repo) ---
docs/
*.md
LICENSE*

# --- Secrets: belt-and-suspenders (deploy/.env.example is keys-only and
#     lives one level down, so it is not caught by these root patterns) ---
.env
.env.*
**/*.pem
**/*.key
# credential files read by path (production mounts its own ./secrets)
secrets/
# the deploy host's pinned SSH key: read by CI, never by the site
deploy/known_hosts

# --- Data that only workstation tools read ---
# Harvest output and its retired importer: run from a checkout, never in the
# container (a site's harvest now writes through its own writer).
scripts/harvest/*.json
scripts/import_events.php

# --- OS / editor noise ---
**/.DS_Store
**/Thumbs.db
.idea/
.vscode/
**/*.swp
