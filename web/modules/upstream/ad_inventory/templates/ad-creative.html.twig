{#
/**
 * @file
 * A booked or house creative: a <picture>, linked through the counted click.
 *
 * Available variables:
 * - href: The click address (/ad/c/<creative>?slot=<slot>), or empty.
 * - alt: The alternative text.
 * - desktop: src, srcset (1x, 2x), width, height.
 * - phone: media, srcset, width, height; or NULL.
 */
#}
{% set picture %}
  <picture>
    {% if phone %}
      <source media="{{ phone.media }}" srcset="{{ phone.srcset }}" width="{{ phone.width }}" height="{{ phone.height }}">
    {% endif %}
    <img class="ad-creative__image" src="{{ desktop.src }}" srcset="{{ desktop.srcset }}" width="{{ desktop.width }}" height="{{ desktop.height }}" alt="{{ alt }}" loading="lazy" decoding="async">
  </picture>
{% endset %}
{% if href %}
  <a class="ad-creative" href="{{ href }}" rel="sponsored noopener">{{ picture }}</a>
{% else %}
  <span class="ad-creative">{{ picture }}</span>
{% endif %}
