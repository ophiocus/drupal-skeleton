{#
/**
 * @file
 * The snippet a mail template keeps for an email banner space.
 *
 * Plain table markup with inline styles, as mail clients expect. The image
 * and the link are this site's stable URLs for the space; what they show is
 * the booking in force on the day the mail is opened.
 */
#}
<table role="presentation" width="{{ width }}" cellpadding="0" cellspacing="0" border="0" style="max-width:100%;margin:16px auto;">
  <tr><td style="font:11px/1.3 Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#888;padding:0 0 4px;">{{ label }}</td></tr>
  <tr><td><a href="{{ link }}" rel="sponsored noopener"><img src="{{ image }}" width="{{ width }}" height="{{ height }}" alt="{{ alt }}" style="display:block;width:100%;max-width:{{ width }}px;height:auto;border:0;"></a></td></tr>
</table>
