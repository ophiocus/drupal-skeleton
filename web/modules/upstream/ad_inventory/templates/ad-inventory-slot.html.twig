{#
/**
 * @file
 * One banner space.
 *
 * The same markup reaches every reader of the page, and it carries no text:
 * a reader with no choice made, a crawler or a browser without JavaScript gets
 * an empty space. The box keeps the format's proportion (desktop, then phone
 * below the breakpoint) so nothing moves when it fills. The creative or unit
 * and the "turned off" notice wait inert inside <template>; ad-inventory.js
 * adds the label and swaps in the creative once the reader's advertising
 * consent is granted, or the notice once it is refused, and never before.
 *
 * Available variables:
 * - slot_id, source, creative_id: what fills it, for counting.
 * - devices: 'both', 'desktop' or 'phone' (where this placement shows).
 * - draft: TRUE when only staff previewing drafts see it.
 * - desktop, phone: {width, height} in CSS pixels.
 * - label: the label above every space, set by ad-inventory.js when the space
 *   shows something.
 * - blocked_reason, blocked_link, consent_attribute: the notice and the link
 *   that reopens the site's cookie settings.
 * - candidates: what may fill the space, each {id, content, caption}: the
 *   creative's <picture> (or the provider's unit, id 0) and a line printed
 *   under it. With several (house banners), the browser shows one at
 *   random.
 */
#}
<aside class="ad-inventory ad-inventory--{{ devices }}{{ draft ? ' ad-inventory--draft' }}"
  data-ad-slot="{{ slot_id }}" data-ad-source="{{ source }}" data-ad-creative="{{ creative_id }}"
  style="--ad-dw: {{ desktop.width }}; --ad-dh: {{ desktop.height }}; --ad-pw: {{ phone.width }}; --ad-ph: {{ phone.height }};"
  data-ad-label="{{ label }}">
  <p class="ad-inventory__label">{% if draft %}<span class="ad-inventory__draft">{{ 'draft'|t }}</span>{% endif %}</p>
  <div class="ad-inventory__box"></div>
  <template class="ad-inventory__notice"><p class="ad-inventory__blocked"><span>{{ blocked_reason }}</span> <a href="#" {{ consent_attribute }}>{{ blocked_link }}</a></p></template>
  {% for candidate in candidates %}
  <template class="ad-inventory__fill" data-ad-creative="{{ candidate.id }}">{{ candidate.content }}{% if candidate.caption %}<p class="ad-inventory__caption">{{ candidate.caption }}</p>{% endif %}</template>
  {% endfor %}
</aside>
