{#
/**
 * @file
 * One ad slot.
 *
 * The box first holds the blocked banner (text and the consent link, no
 * image). Everything that may fill it sits in the inert <template>, whose
 * images and scripts the browser never requests; js/ad-inventory.js moves
 * one entry into the box only after the reader grants advertising consent.
 * The caption line is always there, so filling it moves nothing.
 *
 * Available variables:
 * - slot: The slot id.
 * - label: The site-wide label (printed above the box).
 * - blocked_text, blocked_link_text, blocked_link_url: The blocked banner.
 * - entries: Each with attributes (data-ad-kind, data-ad-creative, …) and
 *   content (a creative's picture, or a network unit's code).
 * - attributes: data-ad-slot, data-ad-desktop, data-ad-phone, aria-label.
 */
#}
<aside{{ attributes }}>
  <p class="ad-slot__label">{{ label }}</p>
  <div class="ad-slot__box">
    <div class="ad-slot__blocked">
      <p class="ad-slot__blocked-text">{{ blocked_text }}</p>
      {% if blocked_link_text %}
        <a class="ad-slot__consent" href="{{ blocked_link_url }}" data-ad-consent-open>{{ blocked_link_text }}</a>
      {% endif %}
    </div>
  </div>
  <p class="ad-slot__caption"></p>
  {% if entries %}
    <template class="ad-slot__fill">
      {% for entry in entries %}
        <div class="ad-slot__entry"{{ entry.attributes }}>{{ entry.content }}</div>
      {% endfor %}
    </template>
  {% endif %}
</aside>
