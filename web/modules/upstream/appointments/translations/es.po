msgstr "Tu cita en @site"

msgid "Hello @name,"
msgstr "Hola @name:"

msgid "Your appointment is confirmed: @service, @when."
msgstr "Tu cita está confirmada: @service, @when."

msgid "Your appointment has moved to @when (@service)."
msgstr "Tu cita pasó al @when (@service)."

msgid "Your appointment of @when (@service) is cancelled."
msgstr "Tu cita del @when (@service) quedó cancelada."

msgid "The payment for @service on @when was not completed in time, so the slot was released. You are welcome to book again."
msgstr "El pago de @service del @when no se completó a tiempo, así que la hora quedó libre. Puedes volver a agendar cuando quieras."

msgid "@service, @when."
msgstr "@service, @when."

msgid "Add it to your calendar: @ics"
msgstr "Agrégala a tu calendario: @ics"

msgid "To cancel or change it: @url"
msgstr "Para cancelarla o cambiarla: @url"

msgid "It is too close to the appointment to change it online. Please call us."
msgstr "Ya falta muy poco para la cita para cambiarla en línea. Por favor llámanos."

msgid "Keep this page private: its address is what lets you change the appointment."
msgstr "No compartas esta página: su dirección es lo que te permite cambiar la cita."

msgid "Choose what you would like to book."
msgstr "Elige lo que quieres agendar."

msgid "See free times"
msgstr "Ver horas libres"

msgid "There is nothing to book at the moment."
msgstr "Por ahora no hay nada para agendar."

msgid "Your appointment is now on @when. Choose the new time."
msgstr "Tu cita está ahora el @when. Elige la nueva hora."

msgid "No free times on these days."
msgstr "No hay horas libres en estos días."

msgid "Try the next days."
msgstr "Prueba los días siguientes."

msgid "Times are in @tz."
msgstr "Las horas están en @tz."

