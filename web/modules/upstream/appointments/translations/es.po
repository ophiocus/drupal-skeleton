msgstr "Notas: @notes"

msgid "The payment arrived after the hold ran out and the slot had been taken. Contact the client to agree a new time or a refund (payment reference: @ref)."
msgstr "El pago llegó cuando la reserva ya había vencido y la hora estaba tomada. Contacta al cliente para acordar otra hora o una devolución (referencia de pago: @ref)."

msgid "Your appointment at @site: @when"
msgstr "Tu cita en @site: @when"

