msgid "Opening hours"
msgstr "Horario de atención"

msgid "Ranges per day as HH:MM-HH:MM, comma-separated (e.g. 08:00-12:00, 14:00-18:00). Leave a day empty when closed."
msgstr "Franjas por día como HH:MM-HH:MM, separadas por comas (p. ej. 08:00-12:00, 14:00-18:00). Deja vacío el día que no se atiende."

msgid "Closed dates"
msgstr "Fechas cerradas"

msgid "One date per line, YYYY-MM-DD (holidays, vacations)."
msgstr "Una fecha por línea, AAAA-MM-DD (festivos, vacaciones)."

msgid "Booking rules"
msgstr "Reglas de agendamiento"

msgid "Minutes between offered start times"
msgstr "Minutos entre las horas de inicio ofrecidas"

msgid "Minimum notice (minutes)"
msgstr "Anticipación mínima (minutos)"

msgid "Days ahead that can be booked"
msgstr "Días hacia adelante que se pueden agendar"

msgid "Appointments at the same time"
msgstr "Citas a la misma hora"

msgid "Clients can cancel or move until this many minutes before"
msgstr "Los clientes pueden cancelar o cambiar hasta estos minutos antes"

msgid "Minutes an unpaid booking holds its time"
msgstr "Minutos que una reserva sin pagar retiene su hora"

msgid "Time zone"
msgstr "Zona horaria"

msgid "An IANA name such as America/Bogota. Empty: the site default."
msgstr "Un nombre IANA como America/Bogota. Vacío: la del sitio."

msgid "Staff e-mail"
msgstr "Correo del personal"

msgid "Who is told about new, moved and cancelled appointments. Comma-separated. Empty: the site e-mail."
msgstr "Quién recibe aviso de citas nuevas, cambiadas y canceladas. Separados por comas. Vacío: el correo del sitio."

msgid "Payment"
msgstr "Pago"

msgid "When booking, the client pays"
msgstr "Al agendar, el cliente paga"

msgid "Nothing online (pays at the appointment)"
msgstr "Nada en línea (paga en la cita)"

msgid "A deposit online"
msgstr "Un abono en línea"

msgid "The full price online"
msgstr "El precio completo en línea"

msgid "Online payment goes through the shop checkout. Services priced 0 are always booked without payment."
msgstr "El pago en línea pasa por el checkout de la tienda. Los servicios con precio 0 siempre se agendan sin pago."

msgid "Online payment needs the Appointments: Commerce module. Until it is enabled, every booking is free."
msgstr "El pago en línea necesita el módulo Appointments: Commerce. Mientras no esté activo, toda cita es sin pago."

msgctxt "appointment payment"
msgid "Deposit"
msgstr "Abono"

msgid "A percentage of the price"
msgstr "Un porcentaje del precio"

msgid "A fixed amount"
msgstr "Un valor fijo"

msgid "Deposit value"
msgstr "Valor del abono"

msgid "Currency"
msgstr "Moneda"

msgid "ISO 4217 code of the service prices, e.g. COP."
msgstr "Código ISO 4217 de los precios de los servicios, p. ej. COP."

msgid "%range is not a range like 08:00-12:00."
msgstr "%range no es una franja como 08:00-12:00."

msgid "%date is not a date like 2026-12-25."
msgstr "%date no es una fecha como 2026-12-25."

msgid "%tz is not a time zone name."
msgstr "%tz no es un nombre de zona horaria."

msgid "Use a three-letter currency code."
msgstr "Usa un código de moneda de tres letras."

msgid "A percentage cannot exceed 100."
msgstr "Un porcentaje no puede pasar de 100."

