msgstr "Se guardó el servicio %label."

msgid "@service, @when"
msgstr "@service, @when"

msgid "To hold this time you pay @amount online on the next step."
msgstr "Para reservar esta hora pagas @amount en línea en el siguiente paso."

msgid "Continue to payment"
msgstr "Continuar al pago"

msgid "Confirm the appointment"
msgstr "Confirmar la cita"

msgid "Too many bookings from your connection. Please call us, or try again in an hour."
msgstr "Demasiadas citas desde tu conexión. Llámanos, o vuelve a intentarlo en una hora."

msgid "Sorry, that time was just taken. Please choose another."
msgstr "Lo sentimos, alguien acaba de tomar esa hora. Por favor elige otra."

msgid "Your appointment is booked. We sent the details to %mail."
msgstr "Tu cita quedó agendada. Enviamos los detalles a %mail."

msgid "Cancel your appointment of @when?"
msgstr "¿Cancelar tu cita del @when?"

msgid "The time will be freed for someone else. About the amount you paid online, we will contact you."
msgstr "La hora quedará libre para otra persona. Sobre lo que pagaste en línea, te contactaremos."

msgid "The time will be freed for someone else."
msgstr "La hora quedará libre para otra persona."

msgid "Your appointment is cancelled."
msgstr "Tu cita quedó cancelada."

msgid "Move your appointment to @new?"
msgstr "¿Pasar tu cita al @new?"

msgid "It is now on @when."
msgstr "Ahora está el @when."

msgid "Move it"
msgstr "Cambiarla"

msgid "Your appointment has moved. We sent you the new details."
msgstr "Tu cita cambió de hora. Te enviamos los nuevos detalles."

msgid "Sorry, that time is no longer free. Please choose another."
msgstr "Lo sentimos, esa hora ya no está libre. Por favor elige otra."

