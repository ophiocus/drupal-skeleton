{#
/**
 * @file
 * Step 1 of booking: the services.
 *
 * Available variables:
 * - services: list of label, description, duration, price, online, url.
 */
#}
<div class="appointments">
  {% if services %}
    <p>{{ 'Choose what you would like to book.'|t }}</p>
    <ul class="appointments-services">
      {% for service in services %}
        <li class="appointments-service">
          <h2 class="appointments-service__title">{{ service.label }}</h2>
          {% if service.description %}
            <p>{{ service.description }}</p>
          {% endif %}
          <p class="appointments-service__meta">
            {{ service.duration }}{% if service.price %} · {{ service.price }}{% endif %}
          </p>
          {% if service.online %}
            <p class="appointments-note">{{ service.online }}</p>
          {% endif %}
          <a class="appointments-button" href="{{ service.url }}">{{ 'See free times'|t }}</a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>{{ 'There is nothing to book at the moment.'|t }}</p>
  {% endif %}
</div>
