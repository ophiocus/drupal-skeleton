    "type": "metapackage",
    "version": "1.0.0",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.0",
        "drupal/adsense": "^1.5",
        "drupal/adstxt": "^1.5",
        "drupal/captcha": "^2.0.11",
        "drupal/core-composer-scaffold": "~11.4.12",
        "drupal/core-project-message": "~11.4.12",
        "drupal/core-recommended": "~11.4.12",
        "drupal/encrypt": "^3.2",
        "drupal/google_tag": "^2.0",
        "drupal/key": "^1.22",
        "drupal/maper": "1.0.0-alpha3",
        "drupal/metatag": "^2.2",
        "drupal/pathauto": "^1.15",
        "drupal/real_aes": "^2.6",
        "drupal/security_review": "^3.1",
        "drupal/simple_sitemap": "^4.2",
        "drupal/symfony_mailer_lite": "^2.0",
        "drupal/tfa": "^1.13",
